{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AUTH_URL",
    "GROQ_API_KEY",
    "TAVILY_API_KEY",
    "AGENT_SUPABASE_ACCESS_TOKEN",
    "E2B_API_KEY",
    "GOOGLE_GENERATIVE_AI_API_KEY",
    "OPEN_AGENTS_RESOURCE_PROFILE",
    "BETTER_AUTH_URL"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    }
  }
}
